# IBM Quantum Platform / Runtime
# Token = IBM Cloud API key (recommended by the Runtime docs)
IBM_QUANTUM_TOKEN="PASTE_YOUR_IBM_CLOUD_API_KEY_HERE"

# Optional: instance (CRN or service name). If empty, QiskitRuntimeService may auto-select.
IBM_QUANTUM_INSTANCE=""

# Optional: preferred region ("us-east" or "eu-de")
IBM_QUANTUM_REGION="us-east"

# Recommended channel: ibm_quantum_platform
IBM_QUANTUM_CHANNEL="ibm_quantum_platform"
